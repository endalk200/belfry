{
	"name": "@belfry",
	"private": true,
	"license": "MIT",
	"scripts": {
		"acceptance:fixture": "bun run scripts/otel-sdk-fixture.ts",
		"benchmark:workbench": "bun run scripts/benchmark-workbench.ts",
		"changeset": "changeset",
		"dev": "bun run belfry --",
		"dev:watch": "turbo watch build",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"test": "turbo run test",
		"format": "turbo run format",
		"format:check": "turbo run format:check",
		"check-types": "turbo run check-types",
		"cli": "bun --conditions=development run apps/cli/src/bin.ts --",
		"release:audit": "bun run scripts/audit-release.ts",
		"release:smoke": "bun run scripts/smoke-npm-package.ts",
		"release:verify": "bun run scripts/verify-npm-package.ts",
		"belfry": "bun --conditions=development run apps/cli/src/bin.ts --",
		"sync-cli-version": "bun run scripts/sync-cli-version.ts",
		"version-packages": "changeset version && bun run sync-cli-version"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@changesets/cli": "^2.31.0",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/api-logs": "^0.220.0",
		"@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
		"@opentelemetry/resources": "^2.9.0",
		"@opentelemetry/sdk-logs": "^0.220.0",
		"@opentelemetry/sdk-trace-base": "^2.9.0",
		"@playwright/test": "^1.59.1",
		"@types/bun": "^1.3.14",
		"turbo": "^2.10.5",
		"typescript": "7.0.2"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"overrides": {
		"hono": "4.12.22",
		"@effect/platform-node-shared": "4.0.0-beta.97",
		"@opentelemetry/core": "2.8.0",
		"undici": "8.5.0",
		"vite": "8.0.16",
		"ws": "8.21.0"
	},
	"packageManager": "bun@1.3.6",
	"workspaces": [
		"apps/*",
		"packages/*",
		"scripts"
	]
}
