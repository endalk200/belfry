{
	"name": "@belfry/tui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/public.d.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"format": "biome format --write package.json tsconfig.json vitest.config.ts src",
		"format:check": "biome format package.json tsconfig.json vitest.config.ts src",
		"lint": "biome check package.json tsconfig.json vitest.config.ts src",
		"lint:fix": "biome check --fix package.json tsconfig.json vitest.config.ts src",
		"test": "vitest run src --passWithNoTests"
	},
	"dependencies": {
		"@belfry/query-api": "workspace:*",
		"@belfry/telemetry": "workspace:*",
		"@belfry/workspace": "workspace:*",
		"@opentui/core": "0.4.3",
		"@opentui/react": "0.4.3",
		"effect": "4.0.0-beta.97",
		"react": "^19.2.7"
	},
	"devDependencies": {
		"@belfry/typescript-config": "workspace:*",
		"@effect/vitest": "4.0.0-beta.97",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.17",
		"typescript": "6.0.3",
		"vitest": "^4.1.10"
	}
}
