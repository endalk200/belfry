{
	"name": "@belfry/cli",
	"version": "0.1.2",
	"description": "Local-only OpenTelemetry trace and log workbench for application development",
	"private": false,
	"type": "module",
	"bin": {
		"belfry": "dist/bin.js"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/endalk200/belfry.git",
		"directory": "apps/cli"
	},
	"homepage": "https://github.com/endalk200/belfry#readme",
	"bugs": {
		"url": "https://github.com/endalk200/belfry/issues"
	},
	"keywords": [
		"bun",
		"local-development",
		"logs",
		"observability",
		"opentelemetry",
		"otlp",
		"sqlite",
		"tracing"
	],
	"license": "MIT",
	"engines": {
		"bun": ">=1.3.0"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "bun run ../../scripts/build-cli.ts",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"format": "biome format --write package.json tsconfig.json turbo.json README.md CHANGELOG.md THIRD_PARTY_NOTICES.md src",
		"format:check": "biome format package.json tsconfig.json turbo.json README.md CHANGELOG.md THIRD_PARTY_NOTICES.md src",
		"lint": "biome check package.json tsconfig.json turbo.json README.md CHANGELOG.md THIRD_PARTY_NOTICES.md src",
		"lint:fix": "biome check --fix package.json tsconfig.json turbo.json README.md CHANGELOG.md THIRD_PARTY_NOTICES.md src",
		"test": "vitest run src --passWithNoTests"
	},
	"devDependencies": {
		"@belfry/config": "workspace:*",
		"@belfry/daemon": "workspace:*",
		"@belfry/storage": "workspace:*",
		"@belfry/typescript-config": "workspace:*",
		"@belfry/web": "workspace:*",
		"@effect/opentelemetry": "4.0.0-rc.111",
		"@effect/platform-bun": "4.0.0-rc.111",
		"@effect/sql-sqlite-bun": "4.0.0-rc.111",
		"@effect/vitest": "4.0.0-rc.111",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/api-logs": "^0.221.0",
		"@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
		"@opentelemetry/resources": "^2.10.0",
		"@opentelemetry/sdk-logs": "^0.221.0",
		"@opentelemetry/sdk-trace-base": "^2.10.0",
		"@opentelemetry/sdk-trace-web": "^2.10.0",
		"@opentelemetry/semantic-conventions": "^1.42.0",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.2.0",
		"effect": "4.0.0-rc.111",
		"typescript": "7.0.2",
		"vitest": "^4.1.11"
	}
}
