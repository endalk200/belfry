{
	"name": "@belfry/storage",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"format": "biome format --write package.json tsconfig.json src",
		"format:check": "biome format package.json tsconfig.json src",
		"lint": "biome check package.json tsconfig.json src",
		"lint:fix": "biome check --fix package.json tsconfig.json src",
		"test": "vitest run src --passWithNoTests"
	},
	"dependencies": {
		"@belfry/query-api": "workspace:*",
		"@belfry/telemetry": "workspace:*",
		"@effect/sql-sqlite-bun": "4.0.0-rc.111",
		"effect": "4.0.0-rc.111"
	},
	"devDependencies": {
		"@belfry/typescript-config": "workspace:*",
		"@effect/vitest": "4.0.0-rc.111",
		"@types/bun": "^1.4.0",
		"typescript": "7.0.2",
		"vitest": "^4.1.11"
	}
}
