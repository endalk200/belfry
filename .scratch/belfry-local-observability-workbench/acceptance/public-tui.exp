if {$argc != 2} {
  puts stderr "Usage: expect public-tui.exp <installed-belfry> <transcript>"
  exit 2
}

set binary [lindex $argv 0]
set transcript [lindex $argv 1]
set timeout 20
log_file -noappend $transcript
spawn -noecho $binary

expect "BELFRY"
expect "POST /checkout"
send -- "\r"
expect "WATERFALL"
send -- "j"
expect "3333333333333333"
send -- "l"
expect "LOGS"
expect "inventory reservation declined"
send -- "\r"
expect "SELECTED LOG"
send -- "t"
expect "SELECTED SPAN"
send -- "?"
expect "COMMANDS"
send -- "q"
expect eof

set result [wait]
set exitCode [lindex $result 3]
if {$exitCode != 0} {
  puts stderr "Installed TUI exited with $exitCode"
  exit $exitCode
}
puts "BELFRY_PUBLIC_TUI_ACCEPTANCE=pass"
